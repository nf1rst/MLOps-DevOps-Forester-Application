@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using forester.Domain.Entities

@inject SignInManager<User> SignInManager
@inject NavigationManager NavigationManager

<AuthorizeView>
    <div class="menu-bar">
        <div class="nav-bar">
            <nav>
                <ul class="nav-bar-list">
                    <li><a href="/">Home</a></li>
                    <li><a href="instructions">Instructions</a></li>
                    <li><a href="batchPrediction">Batch prediction</a></li>
                    <li><a class="singlePrediction" href="singlePrediction">Single prediction</a></li>
                </ul>
            </nav>
        </div>

        <div class="profile-bar">
            <nav>
                <ul>
                    <li><a class="profile-button" href="profile">Profile(@context.User.Identity.Name)</a></li>
                    <li><a class="logout-button" @onclick="LogOutUserAsync">Logout</a></li>
                </ul>
            </nav>
        </div>
    </div>
</AuthorizeView>

<style>
    .menu-bar {
        display: flex;
        justify-content: space-between;
        background-color: rgb(35, 74, 25);
        margin: 0;
        padding: 0;
        text-align: center;
    }

    .nav-bar {
        width: 30%;
    }

    ul {
        display: flex;
        margin: 0;
        padding: 0;
        padding: 1%;
    }

    li {
        padding: 1%;
        list-style: none;
        border-right: 2px double black;
    }

    a {
        width: 20%;
        text-decoration: none;
        color: black;
    }

    .profile-bar {
        width: 10%;
        text-align: center;
        align-content: center;
        display: flex;
    }

    .profile-button {
        width: 50%;
    }

    .logout-button {
        background-color: rgb(168, 10, 10);
        border-radius: 15px;
        margin: 1%;
        cursor: pointer;
    }
</style>

@code {
    private async Task LogOutUserAsync()
    {
        await SignInManager.SignOutAsync();
        NavigationManager.NavigateTo("/login");
    }
}