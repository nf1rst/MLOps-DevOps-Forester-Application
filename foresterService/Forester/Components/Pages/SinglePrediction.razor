@page "/singlePrediction"
@using System.Text.RegularExpressions
@using Forester.Application.Services
@using Microsoft.AspNetCore.Components.Authorization
@using forester.Domain.Entities
@using Microsoft.AspNetCore.Components;

@rendermode InteractiveServer
@* https://stackoverflow.com/questions/65349476/blazor-cant-find-referenced-component-from-other-folder *@

@inject ILogService logService

<h2>Single Prediction</h2>

<h6>Please enter values for single prediction of cover</h6>

<AuthorizeView>
    <div class="input-container">
        <div class="input-row">
            <label>Elevation</label>
            @*https://stackoverflow.com/questions/69888168/how-to-set-input-box-value-to-a-string-in-blazor-webassembly *@
            <input type="number" @bind="userInputs.Elevation" />
        </div>
        <div class="input-row">
            <label>Aspect</label>
            <input type="number" @bind="userInputs.Aspect" />
        </div>
        <div class="input-row">
            <label>Slope</label>
            <input type="number" @bind="userInputs.Slope" />
        </div>
        <div class="input-row">
            <label>Vertical distance to hydrology</label>
            <input type="number" @bind="userInputs.Vertical_Distance_To_Hydrology" />
        </div>
        <div class="input-row">
            <label>Horizontal distance to hydrology</label>
            <input type="number" @bind="userInputs.Horizontal_Distance_To_Hydrology" />
        </div>
        <div class="input-row">
            <label>Horizontal distance to roadways</label>
            <input type="number" @bind="userInputs.Horizontal_Distance_To_Roadways" />
        </div>
        <div class="input-row">
            <label>Hillshade at 9 am</label>
            <input type="number" @bind="userInputs.Hillshade_9am" />
        </div>
        <div class="input-row">
            <label>Hillshade at 12 am </label>
            <input type="number" @bind="userInputs.Hillshade_Noon" />
        </div>
        <div class="input-row">
            <label>Hillshade at 3 pm</label>
            <input type="number" @bind="userInputs.Hillshade_3pm" />
        </div>
        <div class="input-row">
            <label>Horizontal distance to fire points </label>
            <input type="number" @bind="userInputs.Horizontal_Distance_To_Fire_Points" />
        </div>
        <div class="input-row">
            <label>Wilderness area (1-4) </label>
            <input type="number" @bind="userInputs.Wilderness_Area" />
        </div>
        <div class="input-row">
            <label>Soil type (1-40) </label>
            <input type="number" @bind="userInputs.Soil_Type" />
        </div>
        <button class="submit" type="button" @onclick="HandlePrediction">Submit input data</button>
        <div class="error-container">
            <p class="error-text">@errorMessage</p>
        </div>

        <div class="model-answer-area">
            <label>Model answer: </label>
            <p className="model-answer">@modelPredictionResult</p>
        </div>

    </div>
</AuthorizeView>

<style>
    h2,
    h6 {
        text-align: center;
        margin-top: 1%;
    }

    .submit {
        margin-top: 2%;
        background-color: darkorange;
        width: 50%;
    }

    .error-text {
        color: red;
    }

    .input-container {
        width: 60%;
        margin-left: auto;
        margin-right: auto;
        text-align: center;
    }

    .input-row {
        width: 70%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 2%;
        margin-left: auto;
        margin-right: auto;
    }

    .model-answer-area {
        border: 1px solid orange;
        width: 70%;
        margin-left: auto;
        margin-right: auto;
    }
</style>

@code {
    private UserInputs userInputs = new();
    private string errorMessage = "";
    private const string modelContactContainerURL = "http://fastapi-app:8000/";
    private const string modelContactURLLocal = "http://localhost:8000";
    private int modelPredictionResult = 0;

    [Inject] private ILogService LogService { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState> authStateTask { get; set; } = default!;
    private async Task HandlePrediction()
    {
        if (validInputValues(userInputs))
        {
            try
            {
                HttpClient client = new HttpClient();
                client.BaseAddress = new Uri(modelContactContainerURL);

                HttpResponseMessage response = await client.PostAsJsonAsync("predict", userInputs, new
System.Text.Json.JsonSerializerOptions
                {
                    PropertyNamingPolicy = null
                });


                //https://stackoverflow.com/questions/4734116/find-and-extract-a-number-from-a-string
                string predictionResultString = Regex.Match(await response.Content.ReadAsStringAsync(), @"\d+").Value;

                modelPredictionResult = int.Parse(predictionResultString);

                StateHasChanged();

                var authState = await authStateTask;
                var user = authState.User;
                string username = "N/A";
                if (user.Identity?.IsAuthenticated == true)
                {
                    username = user.Identity.Name!;
                }
                await LogService.InsertSingleUserPredictionRequest(userInputs, modelPredictionResult, username);

            }
            catch (Exception e)
            {
                Console.WriteLine($"Connection to API failed: {e.Message}");
                errorMessage = "Model cannot be contacted, blame the developers and please try again later";
            }
            //https://learn.microsoft.com/en-us/dotnet/fundamentals/networking/http/httpclient
            //contact FASTAPI for model prediciton

        }
        else
        {
            errorMessage = "Invalid input values detected, please try again";
        }

    }

    private bool validInputValues(UserInputs model)
    {
        return true;
        //TODO
    }

    private bool HillshadeBetween0And255(int hillshade)
    {
        return (hillshade >= 0 && hillshade <= 255);
    }

}

