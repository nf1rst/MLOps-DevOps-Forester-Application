@page "/login"
@using System.Security.Claims
@using Forester.Application.Interfaces
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Microsoft.AspNetCore.Http;
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore.Metadata.Internal
@using forester.Domain.Entities
@layout NoNavLayout

@inject SignInManager<User> SignInManager
@inject NavigationManager navigationManager

<h2>Login</h2>
<EditForm Model="Input" method="post" OnSubmit="LoginUserAsync" FormName="login" class="login-form">
    <label>Username</label>
    <InputText @bind-Value="Input.Username" />
    <label>Password</label>
    <InputText type="password" @bind-Value="Input.Password" />
    <div class="error-message">@message</div>
    <button type="submit">Login</button>
    <p>Don't have an account? <a href="register">Click to register</a></p>
</EditForm>

<style>
    h2 {
        width: 10%;
        margin-left: auto;
        margin: auto;
        text-align: center;
        margin-top: 1%;
        margin-bottom: 2%;
    }

    .login-form {
        background-color: rgb(19, 20, 19);
        width: 30%;
        margin-left: auto;
        margin-right: auto;
        text-align: center;
        border-radius: 15px;
        font-size: 1.5em;
        padding: 5%;
    }

    label {
        display: block;
    }

    input {
        width: 70%;
        height: 30px;
        background-color: rgb(38, 41, 38);
        border-bottom: 3px solid orange;
        color: white;
    }

    button {
        display: block;
        margin-left: auto;
        margin-right: auto;
        margin-top: 1.3%;
        width: 50%;
        background-color: darkolivegreen;
        height: 30px;
        color: rgb(38, 41, 38);
        font-family: 'Ubuntu Mono';
        font-weight: bolder;
    }

    p a {
        color: orange;
        font-size: 1em;
    }

    .error-message {
        color: red;
    }
</style>

@code {
    [SupplyParameterFromForm] private LoginModel Input { get; set; } = new();
    private string message = "";
    private async Task LoginUserAsync()
    {
        SignInResult? result = await SignInManager.PasswordSignInAsync(Input.Username, Input.Password, false, true);

        if (result.Succeeded == true)
        {
            message = "Login successful, welcome to Forester";
            navigationManager.NavigateTo("/", forceLoad: true);
        }
        else
        {
            message = "Login not successful, please try again";
            Input.Username = "";
            Input.Password = "";
        }
    }

    private sealed class LoginModel
    {
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
    }

}
