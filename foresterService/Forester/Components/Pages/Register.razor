@page "/register"
@using Forester.Application.DTOs
@using Forester.Application.Interfaces
@using Forester.DAL.Repositories
@using Microsoft.AspNetCore.Identity
@using forester.Domain.Entities
@layout NoNavLayout

@rendermode InteractiveServer
@inject UserManager<User> UserManager
@inject NavigationManager navigationManager


<h2>Register</h2>
<div class="register-form">
    <label> Username</label>
    <input class="input-username" type="text" @bind="@username" />
    <label> Password</label>
    <input class="input-password" type="password" @bind="@password" />
    <button type="button" @onclick="RegisterUserAsync">Register</button>
    <p class="error-message">@message</p>
    <p class="no-account-p">Already have an account? <a href="login">Click to login</a></p>
</div>

<style>
    h2 {
        width: 10%;
        margin-left: auto;
        margin: auto;
        text-align: center;
        margin-top: 1%;
        margin-bottom: 2%;
    }

    .register-form {
        background-color: rgb(19, 20, 19);
        width: 30%;
        margin-left: auto;
        margin-right: auto;
        text-align: center;
        border-radius: 15px;
        font-size: 1.5em;
        padding: 5%;
    }

    label {
        display: block;
    }

    input {
        width: 70%;
        height: 30px;
        background-color: rgb(38, 41, 38);
        border-bottom: 3px solid orange;
        color: white;
    }

    button {
        display: block;
        margin-left: auto;
        margin-right: auto;
        margin-top: 1.3%;
        width: 50%;
        background-color: darkolivegreen;
        height: 30px;
        color: rgb(38, 41, 38);
        font-family: 'Ubuntu Mono';
        font-weight: bolder;
    }

    p a {
        color: orange;
        font-size: 1em;
    }

    .error-message {
        color: red;
    }
</style>

@code {
    private string username = "";
    private string password = "";
    private string message = "";
    
    private async Task RegisterUserAsync()
    {
        var user = new User { UserName = username };
        IdentityResult? result = await UserManager.CreateAsync(user, password);

        if (result.Succeeded == true)
        {
            message = "Register successful, redirecting to login...";
            navigationManager.NavigateTo("/login");
        }
        else
        {
            var errors = result.Errors;
            message = $"Register invalid: {errors.FirstOrDefault().Description}";
        }
    }

}